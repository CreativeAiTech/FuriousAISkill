{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{AGENTS}}/hooks/session-watch.cjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{AGENTS}}/hooks/session-watch.cjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit|Agent",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{AGENTS}}/hooks/model-check.mjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    }
  ]
}
