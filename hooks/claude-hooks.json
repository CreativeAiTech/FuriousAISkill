{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{AGENTS}}/hooks/session-watch.cjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{AGENTS}}/hooks/session-watch.cjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash|PowerShell|Agent",
      "hooks": [
        {
          "type": "command",
          "command": "[ -f \"$CLAUDE_PROJECT_DIR/.agents/baton.config.json\" ] && node \"{{AGENTS}}/hooks/model-check.mjs\" || true",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "if": "Write(**/CLAUDE.md)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "if": "Write(**/AGENTS.md)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "if": "Write(**/GEMINI.md)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "if": "Write(**/.agents/rules/**)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "if": "Edit(**/CLAUDE.md)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "if": "Edit(**/AGENTS.md)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "if": "Edit(**/GEMINI.md)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "if": "Edit(**/.agents/rules/**)",
          "command": "node \"{{AGENTS}}/hooks/rule-lint.mjs\"",
          "timeout": 5
        }
      ]
    }
  ]
}
